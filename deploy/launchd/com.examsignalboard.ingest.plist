<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.examsignalboard.ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/saurabhyadav/Desktop/EXAM reminder/scripts/ingest.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/saurabhyadav/Desktop/EXAM reminder</string>

  <!-- Runs once a day at 07:00 IST. The incremental watermark means a
       once-daily run still catches everything published since the last
       run — nothing is skipped, it just batches into one pass instead of
       eight. Picked 07:00 so a full day's postings (and the previous
       overnight ones) are in before most people start checking. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/saurabhyadav/Library/Logs/exam-signal-board/ingest.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/saurabhyadav/Library/Logs/exam-signal-board/ingest.error.log</string>
</dict>
</plist>
