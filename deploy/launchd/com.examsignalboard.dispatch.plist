<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.examsignalboard.dispatch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/saurabhyadav/Desktop/EXAM reminder/scripts/dispatch.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/saurabhyadav/Desktop/EXAM reminder</string>

  <!-- 2 hours after the 07:00 ingestion run — wider buffer than the
       original 30 minutes, in case ingestion runs long on a day with a
       lot of new postings or hits a retry backoff (see withRetry in
       ingest.js), so dispatch never checks against a stale/partial
       exams table. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/saurabhyadav/Library/Logs/exam-signal-board/dispatch.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/saurabhyadav/Library/Logs/exam-signal-board/dispatch.error.log</string>
</dict>
</plist>
